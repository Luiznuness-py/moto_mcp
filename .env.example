# .env.example
#
# Modelo pra gerar o .env real (git-ignored, nunca commitado). Copie:
#   cp .env.example .env
# Depois edite o que fizer sentido pro seu caso — nenhuma linha aqui é
# obrigatória, o servidor funciona sem .env nenhum, só com os defaults
# (stdio local, sem modo de rede). Ver docs/mcp_server.md, "Transporte
# de rede", e docs/guia_maquina_fraca.md pra escolher os valores certos.

# --- Modo de rede (opcional — sem isso, só stdio funciona) ---
# MOTO_MCP_NETWORK_MODE=tailscale
# MOTO_MCP_NETWORK_HOST=100.x.x.x
# MOTO_MCP_NETWORK_PORT=8765

# Modo "lan" exige token — gere um de verdade, nunca deixe um valor
# curto/óbvio (mínimo 32 caracteres, validado no startup):
#   python -c "import secrets; print(secrets.token_hex(32))"
# MOTO_MCP_AUTH_TOKEN=

# --- Busca semântica / Ollama (opcional) ---
# MOTO_MCP_OLLAMA_HOST=http://127.0.0.1:11434
# MOTO_MCP_EMBEDDING_MODEL=bge-m3

# --- Busca web / SearXNG (opcional) ---
# MOTO_MCP_SEARXNG_BASE_URL=http://127.0.0.1:8080
